<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0">
  <head>
    <title>Car Signal Board RSS Example</title>
  </head>
  <body>
    <outline text="Auto RSS Example">
      <outline
        text="盖世汽车-新能源"
        title="盖世汽车-新能源"
        type="rss"
        xmlUrl="https://auto.gasgoo.com/Rss/ClassRss.aspx?ClassId=501"
        htmlUrl="https://auto.gasgoo.com/"
      />
      <outline
        text="CnEVPost China EV"
        title="CnEVPost China EV"
        type="rss"
        xmlUrl="https://cnevpost.com/feed/"
        htmlUrl="https://cnevpost.com/"
      />
      <outline
        text="CarNewsChina EV"
        title="CarNewsChina EV"
        type="rss"
        xmlUrl="https://carnewschina.com/category/electric-vehicles/feed/"
        htmlUrl="https://carnewschina.com/category/electric-vehicles/"
      />
    </outline>
  </body>
</opml>
